# Adapted from Spark v4.2.0 (32f7299601108917fb01920a54e084595b7b3bf8):
# sql/catalyst/src/test/scala/org/apache/spark/sql/catalyst/expressions/
# variant/VariantExpressionSuite.scala, "cast to variant/to_variant_object".
# These cases live in Spark's unit suite, not its SQL input/output fixtures.
# TODO: timestamp JSON formatting/time-zone parity. Temporal conversion is
# checked by schema below instead. Arrow JSON omits the trailing
# .0 on integral floating-point values; only that formatting is adapted here.
# Time-zone support: https://github.com/apache/arrow-rs/issues/11945

statement ok
SET datafusion.execution.time_zone = 'UTC';

query ????????
SELECT false::VARIANT, true::VARIANT,
       0::TINYINT::VARIANT, 1::SMALLINT::VARIANT,
       2::INT::VARIANT, 3::BIGINT::VARIANT,
       4::REAL::VARIANT, 5::DOUBLE::VARIANT;
----
false true 0 1 2 3 4 5

query ???
SELECT CAST(CAST('999999999' AS DECIMAL(9,0)) AS VARIANT),
       CAST(CAST('999999999999999999' AS DECIMAL(18,0)) AS VARIANT),
       CAST(CAST('99999999999999999999999999999999999999' AS DECIMAL(38,0)) AS VARIANT);
----
999999999 999999999999999999 99999999999999999999999999999999999999

query ?B?
SELECT ''::VARIANT,
       to_json(repeat('x', 128)::VARIANT) = '"' || repeat('x', 128) || '"',
       X'010203'::VARIANT;
----
"" true "AQID"

query ?BB
SELECT DATE '1970-01-01'::VARIANT,
       CAST(NULL AS VARIANT) IS NULL AS untyped_null,
       CAST(CAST(NULL AS VARCHAR) AS VARIANT) IS NULL AS typed_null;
----
"1970-01-01" true true

query TT
SELECT schema_of_variant(TIMESTAMP '1970-01-01 00:00:00'::VARIANT),
       schema_of_variant(CAST('1970-01-01 00:00:00Z' AS TIMESTAMP WITH TIME ZONE)::VARIANT);
----
TIMESTAMP_NTZ TIMESTAMP

query ?
SELECT CAST([NULL, 'a', 'b', 'c'] AS VARIANT);
----
[null,"a","b","c"]

statement error use to_variant_object
SELECT CAST(MAP {'z':1, 'y':2, 'x':3} AS VARIANT);

statement error use to_variant_object
SELECT CAST([[MAP {'z':1, 'y':2, 'x':3}]] AS VARIANT);

statement error use to_variant_object
SELECT CAST(named_struct('a', 1) AS VARIANT);

statement error use to_variant_object
SELECT CAST([named_struct('a', 1)] AS VARIANT);

query ???
SELECT to_variant_object([1,2,3]),
       to_variant_object(MAP {'z':1, 'y':2, 'x':3}),
       to_variant_object([[MAP {'z':1, 'y':2, 'x':3}]]);
----
[1,2,3] {"x":3,"y":2,"z":1} [[{"x":3,"y":2,"z":1}]]

query ?
SELECT to_variant_object(named_struct(
  'c', ['123','true','f'], 'b', MAP {'a':'123','b':'true','c':'f'},
  'd', MAP {'a':named_struct('i',132)}, 'a', named_struct('i',0)));
----
{"a":{"i":0},"b":{"a":"123","b":"true","c":"f"},"c":["123","true","f"],"d":{"a":{"i":132}}}

statement error requires an array, struct, or map
SELECT to_variant_object(1);

# Pending upstream kernel support: preserve Spark's expected result rather than
# recording the physical metadata/value serialization as acceptable behavior.
# https://github.com/apache/arrow-rs/issues/11942
skipif DataFusion
query ?
SELECT CAST([parse_json('{"a":1,"b":[1,2,3]}'),
                    parse_json('{"c":true,"d":{"e":"str"}}')] AS VARIANT);
----
[{"a":1,"b":[1,2,3]},{"c":true,"d":{"e":"str"}}]

# DataFusion regressions: errors are checked during planning, even for NULL or
# empty input and TRY_CAST. Containers must not conceal invalid descendants.
statement error use to_variant_object
SELECT TRY_CAST(CAST(NULL AS STRUCT<a INT>) AS VARIANT);

statement error requires string map keys
SELECT to_variant_object([MAP {1:'a'}]);

statement error Cannot convert.*Interval
SELECT CAST(INTERVAL '1 month' AS VARIANT);

statement error Cannot convert.*Interval
SELECT to_variant_object(named_struct('i', INTERVAL '1 month'));

# Arrow's empty/all-null shortcut must not bypass planning-time type checks.
# https://github.com/apache/arrow-rs/issues/11946
statement error Cannot convert.*Duration
SELECT TRY_CAST(arrow_cast(NULL, 'Duration(Microsecond)') AS VARIANT);

statement ok
CREATE TABLE unsupported_conversion_input (v INTERVAL[]);

statement error Cannot convert.*Interval
SELECT CAST(v AS VARIANT) FROM unsupported_conversion_input;

# A declared nested extension field keeps metadata that constructors may drop.
statement ok
CREATE TABLE nested_conversion_input (v STRUCT<child VARIANT>);

statement error Nested VARIANT conversion requires Arrow kernel support
SELECT to_variant_object(v) FROM nested_conversion_input;

statement error requires an array, struct, or map
SELECT to_variant_object(parse_json('{}'));

# CAST of a string wraps it; it does not parse JSON.
query ??
SELECT '{"a":1}'::VARIANT, parse_json('{"a":1}')::VARIANT;
----
"{\"a\":1}" {"a":1}

# Materialization covers batch conversion and extension-field propagation.
statement ok
CREATE TABLE conversion_values AS
SELECT id, i::VARIANT AS v,
       to_variant_object(named_struct('a', i, 'b', [i, NULL])) AS o
FROM (VALUES (1, 7), (2, NULL), (3, -2)) AS t(id, i);

query I? rowsort
SELECT id, v FROM conversion_values;
----
1 7
2 NULL
3 -2

# Null object-field behavior is covered by the pending Spark expectation below.
query I? rowsort
SELECT id, o FROM conversion_values WHERE id <> 2;
----
1 {"a":7,"b":[7,null]}
3 {"a":-2,"b":[-2,null]}

query TT
SELECT arrow_metadata(v, 'ARROW:extension:name'),
       arrow_metadata(o, 'ARROW:extension:name') FROM conversion_values WHERE id = 1;
----
arrow.parquet.variant arrow.parquet.variant

# Getter extraction followed by conversion back to Variant composes both rewrites.
query ?
SELECT CAST(CAST(variant_get(o, 'a') AS INT) AS VARIANT)
FROM conversion_values WHERE id = 1;
----
7

query BB
SELECT to_variant_object(CAST(NULL AS INT[])) IS NULL AS null_array,
       to_variant_object(CAST(NULL AS STRUCT<a INT>)) IS NULL AS null_struct;
----
true true

# Spark keeps null object fields. Arrow ObjectFieldBuilder currently omits them.
# https://github.com/apache/arrow-rs/issues/11947
skipif DataFusion
query ?
SELECT to_variant_object(named_struct('a', CAST(NULL AS INT)));
----
{"a":null}

# DataFusion named_struct currently loses the nested Variant extension metadata.
# Once preserved, Arrow also needs the nested Variant conversion support above.
# https://github.com/apache/arrow-rs/issues/11942
skipif DataFusion
query ?
SELECT to_variant_object(named_struct('v', parse_json('1')));
----
{"v":1}

# TRY_CAST uses Arrow's per-row failure handling, not whole-batch nulling.
query I? rowsort
SELECT id, TRY_CAST(arrow_cast(s, 'Decimal256(39, 0)') AS VARIANT)
FROM (VALUES (1, '7'), (2, '999999999999999999999999999999999999999'), (3, NULL)) AS t(id, s);
----
1 7
2 NULL
3 NULL

statement error (?i)(cast|convert|overflow)
SELECT CAST(arrow_cast('999999999999999999999999999999999999999', 'Decimal256(39, 0)') AS VARIANT);

query BBB
SELECT is_variant_null(TRY_CAST(parse_json('null') AS VARIANT)),
       TRY_CAST(parse_json('null') AS VARIANT) IS NULL AS variant_is_sql_null,
       TRY_CAST(arrow_cast('999999999999999999999999999999999999999', 'Decimal256(39, 0)') AS VARIANT) IS NULL AS failed_is_sql_null;
----
true false true

# Spark rejects duplicate object keys; Arrow's conversion currently keeps the last.
# https://github.com/apache/arrow-rs/issues/11948
skipif DataFusion
statement error (?i)duplicate
SELECT to_variant_object(named_struct('a', 1, 'a', 2));

# A plain struct resembling Variant storage is still an object.
query ?
SELECT to_variant_object(named_struct('metadata', X'010000', 'value', X'00'));
----
{"metadata":"AQAA","value":"AA=="}

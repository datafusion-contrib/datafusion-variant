statement ok
CREATE TABLE json_data (id INT, json_str TEXT) AS VALUES
  (1, '{"name": "Alice", "age": 30}'),
  (2, '{"name": "Bob", "age": 25}'),
  (3, '{"items": [1, 2, 3], "count": 3}'),
  (4, 'null'),
  (5, '"simple string"'),
  (6, '123'),
  (7, 'true');

# Indexing a non-array selects nothing.
query ??
select variant_get(parse_json(json_str), '$.name'), variant_get(parse_json(json_str), '$.age[0]') from json_data;
----
"Alice" NULL
"Bob" NULL
NULL NULL
NULL NULL
NULL NULL
NULL NULL
NULL NULL

# Columns are named after the `:` syntax. The root path and the type-hint form keep the function name.
statement ok
CREATE TABLE events AS SELECT id, parse_json(json_str) AS event FROM json_data;

query TTT
DESCRIBE SELECT event:name, variant_get(event, '$'), variant_get(event, '$.age', 'INT') FROM events;
----
events.event:name Variant YES
variant_get(events.event,Utf8("$")) Variant YES
variant_get(events.event,Utf8("$.age"),Utf8("INT")) Int32 YES

# Qualifiers keep the same path on both sides of a join distinct, also inside an expression input.
query TTT
DESCRIBE SELECT parse_json(a.json_str):name, parse_json(b.json_str):name FROM json_data a JOIN json_data b ON a.id = b.id;
----
parse_json(a.json_str):name Variant YES
parse_json(b.json_str):name Variant YES

# Strict and try getters share extraction; only conversion failure handling differs.
# Scalar/scalar conversions are covered by spark_variant_get_casts_primitives.slt.
statement ok
CREATE TABLE cast_inputs (id INT, doc TEXT, path TEXT) AS VALUES
  (1, '{"n":7}', '$.n'),
  (2, '{"n":128}', '$.n'),
  (3, '{"n":"bad"}', '$.n');

# Array input, scalar path: preserve successful rows when other rows cannot cast.
query I
SELECT try_variant_get(parse_json(doc), '$.n', 'TINYINT')
FROM cast_inputs ORDER BY id;
----
7
NULL
NULL

statement error (?i)(cast|extract|overflow)
SELECT variant_get(parse_json(doc), '$.n', 'TINYINT') FROM cast_inputs;

# Array input and array paths use the same cast policy.
query I
SELECT try_variant_get(parse_json(doc), path, 'TINYINT')
FROM cast_inputs ORDER BY id;
----
7
NULL
NULL

statement error (?i)(cast|extract|overflow)
SELECT variant_get(parse_json(doc), path, 'TINYINT') FROM cast_inputs;

# Scalar input, array paths: a failed cast does not null the entire result.
query I
SELECT try_variant_get(parse_json('{"ok":7,"large":128,"bad":"bad"}'), path, 'TINYINT')
FROM (VALUES (1, '$.ok'), (2, '$.large'), (3, '$.bad')) AS paths(id, path)
ORDER BY id;
----
7
NULL
NULL

statement error (?i)(cast|extract|overflow)
SELECT variant_get(parse_json('{"ok":7,"large":128}'), path, 'TINYINT')
FROM (VALUES ('$.ok'), ('$.large')) AS paths(path);

# Representative shared behavior: both return a usable Variant without a type
# hint. The full extraction matrix is exercised through variant_get elsewhere.
query TT
WITH input AS (SELECT parse_json('{"user":{"age":7}}') AS v)
SELECT to_json(variant_get(v, '$.user')), to_json(try_variant_get(v, '$.user')) FROM input;
----
{"age":7} {"age":7}

# Try must not suppress malformed path errors, for scalar or column paths.
statement error invalid Variant path
SELECT try_variant_get(parse_json('{"n":7}'), '$.n[', 'TINYINT');

statement error invalid Variant path
SELECT variant_get(parse_json('{"n":7}'), '$.n[', 'TINYINT');

statement error invalid Variant path
SELECT try_variant_get(parse_json(doc), path || '[', 'TINYINT') FROM cast_inputs;

statement error invalid Variant path
SELECT try_variant_get(parse_json('{}'), p) FROM (VALUES ('$[')) t(p);

statement error (?i)(parse|unsupported|invalid)
SELECT try_variant_get(parse_json('7'), '$', 'NotAType');

statement error (?i)(parse|unsupported|invalid)
SELECT variant_get(parse_json('7'), '$', 'NotAType');

# Chained `:` access is collapsed into a single getter over the combined path,
# so that shredded fields are read directly (#176).
statement ok
CREATE TABLE nested AS SELECT parse_json(column1) AS v FROM VALUES
  ('{"a": {"b": {"c": [1, {"d": 5}]}}}'),
  ('{"a": {"b": null}}'),
  ('{"a": 7}'),
  (NULL);

statement ok
SET datafusion.explain.logical_plan_only = true;

# Expect to see a single variant_get call, also below a cast.
query TT
EXPLAIN SELECT v:a:b:c[1]:d::INT AS d_int FROM nested;
----
logical_plan
01)Projection: variant_get(nested.v, Utf8("$.a.b.c[1].d")) AS d_int
02)--TableScan: nested projection=[v]

# Chained access keeps working where expressions are matched by name.
query II
SELECT v:a:b:c[1]:d::INT, count(*) FROM nested WHERE v:a:b IS NOT NULL GROUP BY v:a:b:c[1]:d::INT ORDER BY 1;
----
5 1
NULL 1

# try_variant_get collapses as the inner and the outer getter, keeping the
# outer type hint.
query TT
EXPLAIN SELECT try_variant_get(try_variant_get(v, '$.a'), '$.b.c[0]', 'INT') FROM nested;
----
logical_plan
01)Projection: try_variant_get(nested.v, Utf8("$.a.b.c[0]"), Utf8("INT")) AS try_variant_get(try_variant_get(nested.v,Utf8("$.a")),Utf8("$.b.c[0]"),Utf8("INT"))
02)--TableScan: nested projection=[v]

# An inner getter with a type hint is kept, even for 'VARIANT'.
query TT
EXPLAIN SELECT variant_get(variant_get(v, '$.a', 'VARIANT'), '$.b') FROM nested;
----
logical_plan
01)Projection: variant_get(variant_get(nested.v, Utf8("$.a"), Utf8("VARIANT")), Utf8("$.b"))
02)--TableScan: nested projection=[v]

# Non-literal paths are kept.
query TT
EXPLAIN SELECT variant_get(variant_get(v, '$.a'), p) FROM nested, (SELECT '$.b' AS p);
----
logical_plan
01)Projection: variant_get(variant_get(nested.v, Utf8("$.a")), p)
02)--Cross Join:
03)----TableScan: nested projection=[v]
04)----Projection: Utf8("$.b") AS p
05)------EmptyRelation: rows=1

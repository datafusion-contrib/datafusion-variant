# SPDX-License-Identifier: Apache-2.0

# SQL VARIANT has canonical binary-view storage and extension metadata.
statement ok
CREATE TABLE sql_variant_inputs AS
SELECT id, parse_json(j) AS v, 'x' AS path
FROM (VALUES (1, '{"x":7}'), (2, '{"x":{"a":[1,true]}}'),
             (3, '{"x":[1,"two"]}'), (4, '{"x":null}'),
             (5, '{}'), (6, NULL)) AS input(id, j);

# Existing Spark/null SLTs cover extraction semantics. Exercise the new target
# through materialization, with column paths for hints and scalar paths for casts.
statement ok
CREATE TABLE sql_variant_results AS
SELECT id, variant_get(v, path, 'VaRiAnT') AS hinted,
       TRY_CAST(variant_get(v, 'x') AS VARIANT) AS casted
FROM sql_variant_inputs;

query I?? rowsort
SELECT id, hinted, casted FROM sql_variant_results;
----
1 7 7
2 {"a":[1,true]} {"a":[1,true]}
3 [1,"two"] [1,"two"]
4 null null
5 NULL NULL
6 NULL NULL

query TTBB
SELECT arrow_metadata(hinted, 'ARROW:extension:name'),
       arrow_metadata(casted, 'ARROW:extension:name'),
       arrow_typeof(hinted) = arrow_typeof(CAST(NULL AS VARIANT)),
       arrow_typeof(casted) = arrow_typeof(parse_json('7'))
FROM sql_variant_results WHERE id = 1;
----
arrow.parquet.variant arrow.parquet.variant true true

# SQL declarations retain the extension identity through INSERT and reads.
statement ok
CREATE TABLE declared_variant (v VARIANT);

statement ok
INSERT INTO declared_variant SELECT hinted FROM sql_variant_results WHERE id = 1;

# Cast stored values through the root conversion kernel, including :: syntax.
query ?TII
SELECT v, arrow_metadata(v, 'ARROW:extension:name'),
       CAST(v AS INT) AS n, v::BIGINT AS wide FROM declared_variant;
----
7 arrow.parquet.variant 7 7

# Materialized TRY_CAST results preserve SQL NULL, Variant null, and failures.
# The existing input matrix includes a scalar, object, array, null, and missing path.
statement ok
CREATE TABLE cast_variant_results AS
SELECT id, TRY_CAST(hinted AS INT) AS n FROM sql_variant_results;

query II rowsort
SELECT id, n FROM cast_variant_results;
----
1 7
2 NULL
3 NULL
4 NULL
5 NULL
6 NULL

query TB
SELECT arrow_typeof(n), arrow_metadata(n, 'ARROW:extension:name') IS NULL
FROM cast_variant_results WHERE id = 1;
----
Int32 true

statement error (?i)(cast|extract)
SELECT CAST(hinted AS INT) FROM sql_variant_results WHERE id = 2;

# Nested targets retain the try-getter's per-element conversion policy.
query B
SELECT TRY_CAST(hinted AS INT[]) IS NOT DISTINCT FROM [1, NULL]
FROM sql_variant_results WHERE id = 3;
----
true

# Composed scalar expressions retain explicit intermediate conversions.
query R
SELECT CAST(CAST(parse_json('1.9') AS INT) AS DOUBLE);
----
1

# An outer TRY_CAST must not suppress an error from its input expression.
statement error (?i)(cast|extract)
SELECT TRY_CAST(CAST(parse_json('{}') AS INT) AS BIGINT);

statement ok
CREATE TABLE null_variant AS SELECT CAST(NULL AS VARIANT) AS v;

query BT
SELECT v IS NULL, arrow_metadata(v, 'ARROW:extension:name') FROM null_variant;
----
true arrow.parquet.variant

# DataFusion recursively applies the type planner inside composite declarations.
statement ok
CREATE TABLE nested_variant (a VARIANT[], o STRUCT<v VARIANT>);

statement ok
INSERT INTO nested_variant VALUES (NULL, NULL);

query BT
SELECT arrow_typeof(a) LIKE '%arrow.parquet.variant%',
       arrow_metadata(o.v, 'ARROW:extension:name') FROM nested_variant;
----
true arrow.parquet.variant

# Constant folding and a scalar input with column paths use separate dispatch.
query ???
SELECT try_variant_get(parse_json('{"x":7}'), 'x', 'VARIANT'),
       CAST(variant_get(parse_json('{"x":7}'), 'x') AS VARIANT),
       variant_get(parse_json('{"x":7}'), path, 'VARIANT')
FROM sql_variant_inputs WHERE id = 1;
----
7 7 7

# A getter explicitly returning VARIANT remains usable in a subsequent cast.
query II
SELECT CAST(variant_get(v, 'x', 'VARIANT') AS INT) AS hinted,
       v:x::VARIANT::INT AS casted
FROM sql_variant_inputs WHERE id = 1;
----
7 7

# The outer cast controls conversion errors even after an explicit VARIANT target.
query I
SELECT TRY_CAST(variant_get(v, 'x', 'VARIANT') AS INT)
FROM sql_variant_inputs WHERE id = 2;
----
NULL

statement error (?i)(cast|extract)
SELECT CAST(try_variant_get(v, 'x', 'VARIANT') AS INT)
FROM sql_variant_inputs WHERE id = 2;

# Reuse the reference values already asserted in is_variant_null.slt rather
# than duplicating its null/missing matrices. Materialization also checks storage.
statement ok
CREATE TABLE sql_variant_shredded AS
SELECT id, variant_get(v, 'a', 'VARIANT') AS got FROM shredded_null_objects;

# TODO(#71, arrow-rs): Native Variant-target extraction loses the distinction
# between missing paths and Variant null in shredded input. Keep parity pending
# an upstream fix; do not normalize the kernel output locally.
# https://github.com/apache/arrow-rs/pull/11504
skipif DataFusion
query B
SELECT bool_and(to_json(got) IS NOT DISTINCT FROM
                to_json(variant_get(original, 'a')))
FROM sql_variant_shredded JOIN shredded_null_objects USING (id);
----
true

# TODO(#71, arrow-rs): Native Variant-target extraction loses the distinction
# between missing paths and Variant null in shredded input. Keep parity pending
# an upstream fix; do not normalize the kernel output locally.
# https://github.com/apache/arrow-rs/pull/11052
skipif DataFusion
query BB
SELECT bool_and(to_json(variant_get(v, '[0]', 'VARIANT')) IS NOT DISTINCT FROM
                to_json(variant_get(original, '[0]'))),
       bool_and(to_json(variant_get(v, '[1]', 'VARIANT')) IS NOT DISTINCT FROM
                to_json(variant_get(original, '[1]')))
FROM shredded_null_lists;
----
true true

# Identity casts preserve a stored Variant's actual representation.
query BBBB
SELECT to_json(CAST(b AS VARIANT)) = to_json(b),
       to_json(TRY_CAST(l AS VARIANT)) = to_json(l),
       arrow_typeof(CAST(b AS VARIANT)) = arrow_typeof(b),
       arrow_typeof(TRY_CAST(l AS VARIANT)) = arrow_typeof(l)
FROM binary_variant_inputs WHERE b IS NOT NULL;
----
true true true true

statement ok
CREATE TABLE shredded_identity_casts AS
SELECT v, CAST(v AS VARIANT) AS copied, TRY_CAST(v AS VARIANT) AS safe
FROM shredded_null_objects;

query BBB
SELECT bool_and(copied.typed_value IS NOT DISTINCT FROM v.typed_value),
       bool_and(copied IS NULL = (v IS NULL)),
       bool_and(arrow_typeof(safe) = arrow_typeof(v)) FROM shredded_identity_casts;
----
true true true

# Root conversion accepts existing binary layouts without normalizing storage.
statement ok
CREATE TABLE binary_variant_casts AS
SELECT CAST(b AS STRUCT<x INT>) AS b, TRY_CAST(l AS STRUCT<x INT>) AS l
FROM binary_variant_inputs;

query II rowsort
SELECT b.x, l.x FROM binary_variant_casts;
----
7 7
NULL NULL

# Shredded root conversion agrees with extraction from the original values.
# Variant null has a separate pending expectation below.
query B
SELECT bool_and(CAST(v AS STRUCT<a INT, b INT>) IS NOT DISTINCT FROM
                variant_get(original, '', 'STRUCT<a INT, b INT>'))
FROM shredded_null_objects WHERE id <> 2;
----
true

# TODO(#71, arrow-rs): root-to-struct extraction of shredded Variant null returns
# a valid struct of NULL fields. Both CAST and the existing typed getter inherit
# this kernel bug; the result must instead be a SQL NULL struct.
skipif DataFusion
query B
SELECT CAST(v AS STRUCT<a INT, b INT>) IS NULL
FROM shredded_null_objects WHERE id = 2;
----
true

# A physical storage lookalike without Variant metadata uses ordinary SQL casts.
query B
SELECT s.value = X'00' FROM (
  SELECT CAST(named_struct('metadata', X'010000', 'value', X'00')
              AS STRUCT<metadata BINARY, value BINARY>) AS s
);
----
true

# Getters may return any valid Variant binary storage layout.
# TODO(#71): align the UDF's declared physical schema with the kernel result
# so Binary and LargeBinary inputs can be materialized. BinaryView is a preference.
skipif DataFusion
statement ok
CREATE TABLE binary_variant_results AS
SELECT variant_get(b, '', 'VARIANT') AS b,
       CAST(variant_get(l, '') AS VARIANT) AS l FROM binary_variant_inputs;

# TODO(#71): Enable with binary_variant_results once the UDF schema matches its output.
skipif DataFusion
query ?? rowsort
SELECT b, l FROM binary_variant_results;
----
NULL NULL
{"x":7} {"x":7}

# This is type registration, not a new permissive parser for custom type names.
statement error (?i)VARIANT does not accept type parameters
SELECT variant_get(parse_json('7'), '', 'VARIANT(1)');

statement error (?i)(unsupported|not implemented)
SELECT variant_get(parse_json('7'), '', 'other.VARIANT');

# The planner preserves nested metadata, but the upstream extraction kernel
# does not yet implement nested Variant targets. Reject rather than miscast.
statement error (?i)Nested VARIANT getter targets
SELECT variant_get(parse_json('[1,2]'), '', 'ARRAY<VARIANT>');

statement error (?i)Nested VARIANT getter targets
SELECT CAST(variant_get(parse_json('{"a":1}'), '') AS STRUCT<a VARIANT>);

statement error (?i)Nested VARIANT getter targets
SELECT CAST(v AS STRUCT<a VARIANT>) FROM declared_variant;

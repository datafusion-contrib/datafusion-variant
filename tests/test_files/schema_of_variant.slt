# Spark JSON: 1E0
query T
SELECT schema_of_variant(parse_json('1E0'));
----
DOUBLE

# Spark JSON: true
query T
SELECT schema_of_variant(parse_json('true'));
----
BOOLEAN

# Spark JSON: "2000-01-01"
query T
SELECT schema_of_variant(parse_json('"2000-01-01"'));
----
STRING

# Spark JSON: {"a":0}
query T
SELECT schema_of_variant(parse_json('{"a":0}'));
----
OBJECT<a: BIGINT>

# Spark JSON: {"b": {"c": "c"}, "a":["a"]}
query T
SELECT schema_of_variant(parse_json('{"b": {"c": "c"}, "a":["a"]}'));
----
OBJECT<a: ARRAY<STRING>, b: OBJECT<c: STRING>>

# Spark JSON: []
query T
SELECT schema_of_variant(parse_json('[]'));
----
ARRAY<VOID>

# Spark JSON: [false]
query T
SELECT schema_of_variant(parse_json('[false]'));
----
ARRAY<BOOLEAN>

# Spark JSON: [null, 1, 1.0]
# TODO: Arrow 59 JSON parsing does not preserve Spark decimal encodings.
skipif DataFusion
query T
SELECT schema_of_variant(parse_json('[null, 1, 1.0]'));
----
ARRAY<DECIMAL(20,0)>

# Same schema inference over explicitly constructed Spark input values.
query T
SELECT schema_of_variant(variant_list_construct(parse_json('null'), cast_to_variant(1), cast_to_variant(CAST('1' AS DECIMAL(1,0)))));
----
ARRAY<DECIMAL(20,0)>

# Spark JSON: [null, 1, 1.1]
# TODO: Arrow 59 JSON parsing does not preserve Spark decimal encodings.
skipif DataFusion
query T
SELECT schema_of_variant(parse_json('[null, 1, 1.1]'));
----
ARRAY<DECIMAL(21,1)>

# Same schema inference over explicitly constructed Spark input values.
query T
SELECT schema_of_variant(variant_list_construct(parse_json('null'), cast_to_variant(1), cast_to_variant(CAST('1.1' AS DECIMAL(2,1)))));
----
ARRAY<DECIMAL(21,1)>

# Spark JSON: [123456.789, 123.456789]
# TODO: Arrow 59 JSON parsing does not preserve Spark decimal encodings.
skipif DataFusion
query T
SELECT schema_of_variant(parse_json('[123456.789, 123.456789]'));
----
ARRAY<DECIMAL(12,6)>

# Same schema inference over explicitly constructed Spark input values.
query T
SELECT schema_of_variant(variant_list_construct(cast_to_variant(CAST('123456.789' AS DECIMAL(9,3))), cast_to_variant(CAST('123.456789' AS DECIMAL(9,6)))));
----
ARRAY<DECIMAL(12,6)>

# Spark JSON: [1, 11111111111111111111111111111111111111]
# TODO: Arrow 59 JSON parsing does not preserve Spark decimal encodings.
skipif DataFusion
query T
SELECT schema_of_variant(parse_json('[1, 11111111111111111111111111111111111111]'));
----
ARRAY<DECIMAL(38,0)>

# Same schema inference over explicitly constructed Spark input values.
query T
SELECT schema_of_variant(variant_list_construct(cast_to_variant(1), cast_to_variant(CAST('11111111111111111111111111111111111111' AS DECIMAL(38,0)))));
----
ARRAY<DECIMAL(38,0)>

# Spark JSON: [1.1, 11111111111111111111111111111111111111]
# TODO: Arrow 59 JSON parsing does not preserve Spark decimal encodings.
skipif DataFusion
query T
SELECT schema_of_variant(parse_json('[1.1, 11111111111111111111111111111111111111]'));
----
ARRAY<DOUBLE>

# Same schema inference over explicitly constructed Spark input values.
query T
SELECT schema_of_variant(variant_list_construct(cast_to_variant(CAST('1.1' AS DECIMAL(2,1))), cast_to_variant(CAST('11111111111111111111111111111111111111' AS DECIMAL(38,0)))));
----
ARRAY<DOUBLE>

# Spark JSON: [1, "1"]
query T
SELECT schema_of_variant(parse_json('[1, "1"]'));
----
ARRAY<VARIANT>

# Spark JSON: [{}, true]
query T
SELECT schema_of_variant(parse_json('[{}, true]'));
----
ARRAY<VARIANT>

# Spark JSON: [{"c": ""}, {"a": null}, {"b": 1}]
query T
SELECT schema_of_variant(parse_json('[{"c": ""}, {"a": null}, {"b": 1}]'));
----
ARRAY<OBJECT<a: VOID, b: BIGINT, c: STRING>>

# Spark JSON: [{"a": ""}, {"a": null}, {"b": 1}]
query T
SELECT schema_of_variant(parse_json('[{"a": ""}, {"a": null}, {"b": 1}]'));
----
ARRAY<OBJECT<a: STRING, b: BIGINT>>

# Spark JSON: [{"a": 1, "b": null}, {"b": true, "a": 1E0}]
query T
SELECT schema_of_variant(parse_json('[{"a": 1, "b": null}, {"b": true, "a": 1E0}]'));
----
ARRAY<OBJECT<a: DOUBLE, b: BOOLEAN>>

# VariantSuite: schema_of_variant(object), including keyword and special key.
query T
SELECT schema_of_variant(parse_json('{"STRUCT": {"!special!": true}}'));
----
OBJECT<STRUCT: OBJECT<`!special!`: BOOLEAN>>

# SQL NULL is distinct from the Variant null above, for scalar and column inputs.
query T
SELECT schema_of_variant(NULL);
----
NULL

query T
SELECT schema_of_variant(parse_json(NULL));
----
NULL

statement ok
CREATE TABLE schema_rows AS SELECT * FROM (VALUES
  (1, NULL), (2, 'null'), (3, '{"a": 1}'), (4, '[1, 2, 3]'), (5, '{}')
) AS t(id, j);

query IT
SELECT id, schema_of_variant(parse_json(j)) FROM schema_rows ORDER BY id;
----
1 NULL
2 VOID
3 OBJECT<a: BIGINT>
4 ARRAY<BIGINT>
5 OBJECT<>

# Reject unrelated typed NULLs and structs without the Variant extension.
statement error schema_of_variant expects a Variant or untyped NULL argument
SELECT schema_of_variant(CAST(NULL AS INT));

statement error schema_of_variant expects a Variant or untyped NULL argument
SELECT schema_of_variant(named_struct('a', 1));

query T
SELECT schema_of_variant(parse_json('{"a`b": 1, "1a": true, "a_b": 1, "😀": 2, "￿": 3}'));
----
OBJECT<`1a`: BOOLEAN, a_b: BIGINT, `a``b`: BIGINT, `￿`: BIGINT, `😀`: BIGINT>

# VariantExpressionSuite: non-Spark UUID type; primitive header is 20 << 2.
query T
SELECT schema_of_variant(cast_to_variant(X'010000', X'5001010101010101010101010101010101'));
----
UUID

query T
SELECT schema_of_variant(variant_list_construct(
  cast_to_variant(X'010000', X'5001010101010101010101010101010101'), parse_json('null')));
----
ARRAY<UUID>

query T
SELECT schema_of_variant(variant_list_construct(
  cast_to_variant(X'010000', X'5001010101010101010101010101010101'), cast_to_variant('x')));
----
ARRAY<VARIANT>

# All integer encodings are logically BIGINT, including mixed widths.
query TTTTT
SELECT schema_of_variant(cast_to_variant(1::TINYINT)),
       schema_of_variant(cast_to_variant(128::SMALLINT)),
       schema_of_variant(cast_to_variant(32768::INT)),
       schema_of_variant(cast_to_variant(2147483648::BIGINT)),
       schema_of_variant(parse_json('[1,128,32768,2147483648]'));
----
BIGINT BIGINT BIGINT BIGINT ARRAY<BIGINT>

# Declared decimal precision is discarded; encoded scale is preserved.
query TTT
SELECT schema_of_variant(cast_to_variant(CAST('1.00' AS DECIMAL(38,2)))),
       schema_of_variant(cast_to_variant(CAST('0.00000' AS DECIMAL(38,5)))),
       schema_of_variant(cast_to_variant(CAST('-0.01' AS DECIMAL(38,2))));
----
DECIMAL(3,2) DECIMAL(5,5) DECIMAL(2,2)

# Parquet types beyond Spark's SQL type system.
query TTT
SELECT schema_of_variant(cast_to_variant(TIME '12:34:56')),
       schema_of_variant(cast_to_variant(arrow_cast('2000-01-01', 'Timestamp(Nanosecond, Some("UTC"))'))),
       schema_of_variant(cast_to_variant(arrow_cast('2000-01-01', 'Timestamp(Nanosecond, None)')));
----
TIME TIMESTAMP TIMESTAMP_NTZ

# TODO: Arrow 59's full metadata validator rejects the repeated offset for an
# empty key. Keep the desired behavior until parquet-variant accepts this input.
skipif DataFusion
query T
SELECT schema_of_variant(parse_json('{"": null}'));
----
OBJECT<``: VOID>

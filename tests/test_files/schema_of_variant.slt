# Ported from Apache Spark (Apache-2.0), HEAD pinned to
# 4ccf07b6d91e2b126b7001741778ee28f22c6609.
# https://github.com/apache/spark/blob/4ccf07b6d91e2b126b7001741778ee28f22c6609/sql/core/src/test/scala/org/apache/spark/sql/VariantEndToEndSuite.scala
# test("schema_of_variant"): all 31 cases, in upstream order.
# Function mapping: parse_json -> parse_json.
# Arrow 59 JSON parsing produces DOUBLE instead of DECIMAL. For those cases,
# construct Spark's parsed decimal values explicitly; retain original JSON below.
# Decimal precision/scale are inferred from values, not the declared input precision.

# Spark JSON: null
query T
SELECT schema_of_variant(parse_json('null'));
----
VOID

# Spark JSON: 1
query T
SELECT schema_of_variant(parse_json('1'));
----
BIGINT

# Spark JSON: 1.0
# TODO: Arrow 59 JSON parsing does not preserve Spark decimal encodings.
skipif DataFusion
query T
SELECT schema_of_variant(parse_json('1.0'));
----
DECIMAL(1,0)

# Same schema inference over explicitly constructed Spark input values.
query T
SELECT schema_of_variant(cast_to_variant(CAST('1.0' AS DECIMAL(1,0))));
----
DECIMAL(1,0)

# Spark JSON: 0.01
# TODO: Arrow 59 JSON parsing does not preserve Spark decimal encodings.
skipif DataFusion
query T
SELECT schema_of_variant(parse_json('0.01'));
----
DECIMAL(2,2)

# Same schema inference over explicitly constructed Spark input values.
query T
SELECT schema_of_variant(cast_to_variant(CAST('0.01' AS DECIMAL(2,2))));
----
DECIMAL(2,2)


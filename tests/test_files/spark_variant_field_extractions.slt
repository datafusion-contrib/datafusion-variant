# Ported from Apache Spark variant-field-extractions.sql.
# Source commit: 5c63836176a2a15a5d43a61f2e18890eb4ac7ece
# SQL: https://github.com/apache/spark/blob/5c63836176a2a15a5d43a61f2e18890eb4ac7ece/sql/core/src/test/resources/sql-tests/inputs/variant-field-extractions.sql
# Results: https://github.com/apache/spark/blob/5c63836176a2a15a5d43a61f2e18890eb4ac7ece/sql/core/src/test/resources/sql-tests/results/variant-field-extractions.sql.out
# Uses json_to_variant, SQL null predicates, and JSON rendering for variant results.
# Case numbers follow Spark; cases 23-28 isolate extraction from SQL string casts.
# Skipped cases retain Spark expectations. Validated against Spark 4.2.0.

# Create temp view with Variant columns for testing field extraction and type casting.
statement ok
CREATE VIEW variant_test_data AS
SELECT
  json_to_variant('{ "price": 30 }') as int_price_variant,
  json_to_variant('{ "price": 12345.678 }') as double_price_variant,
  json_to_variant('{ "name": "John", "age": 30, "city": "New York", "active": true, "scores": [85, 92, 78] }') as multi_field_variant,
  json_to_variant('{ "item": [ { "model" : "basic", "price" : 6.12 }, { "model" : "medium", "price" : 9.24 } ] }') as array_value_variant,
  json_to_variant('[{ "id": 1, "name": "Alice" }, { "id": 2, "name": "Bob" }, { "id": 3, "name": "Charlie" }]') as array_variant,
  json_to_variant('{ "metadata": { "version": "1.0", "tags": ["important", "urgent"], "nested": { "level": 2, "value": "deep" } } }') as nested_variant,
  json_to_variant('{ "field-name": "value1", "field.name": "value2", "field_name": "value3" }') as special_chars_variant;

# Single field extraction and type casting.
# Spark case 01
# Spark schema: struct<price:variant>
query T
SELECT variant_to_json(c1)
FROM (
  select int_price_variant:price from variant_test_data
) AS spark_result(c1);
----
30

# Spark case 02
# Spark schema: struct<price:decimal(5,2)>
# TODO: Support SQL CAST from variant to the requested SQL type.
skipif DataFusion
query R
select int_price_variant:price::decimal(5, 2) from variant_test_data;
----
30.00

# Spark case 03
# Spark schema: struct<price:string>
# TODO: Support SQL CAST from variant to the requested SQL type.
skipif DataFusion
query T
select int_price_variant:price::string from variant_test_data;
----
30

# Applying an invalid function -- will throw an error.
# Spark case 04
# Spark schema: struct<>
# Spark expected error: INVALID_VARIANT_CAST (DECIMAL(3,2), value 12345.678)
# TODO: Implement variant-to-decimal CAST and report overflow (Spark: INVALID_VARIANT_CAST).
skipif DataFusion
statement error INVALID_VARIANT_CAST
select double_price_variant:price::decimal(3, 2) from variant_test_data;

# Multi-field access.
# Spark case 05
# Spark schema: struct<name:variant,age:variant,city:variant>
query TTT
SELECT variant_to_json(c1), variant_to_json(c2), variant_to_json(c3)
FROM (
  select multi_field_variant:name, multi_field_variant:age, multi_field_variant:city from variant_test_data
) AS spark_result(c1, c2, c3);
----
"John" 30 "New York"

# Spark case 06
# Spark schema: struct<name:string,age:int,active:boolean>
# TODO: Support SQL CAST from variant to the requested SQL type.
skipif DataFusion
query TIB
select multi_field_variant:name::string, multi_field_variant:age::int, multi_field_variant:active::boolean from variant_test_data;
----
John 30 true

# Spark case 07
# Spark schema: struct<name:variant>
query T
SELECT variant_to_json(c1)
FROM (
  select multi_field_variant:['name'] from variant_test_data
) AS spark_result(c1);
----
"John"

# Spark case 08
# Spark schema: struct<age:variant>
query T
SELECT variant_to_json(c1)
FROM (
  select multi_field_variant:['age'] from variant_test_data
) AS spark_result(c1);
----
30


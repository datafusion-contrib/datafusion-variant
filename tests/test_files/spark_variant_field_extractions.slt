# Special characters.
# Special-key extraction is tested independently of SQL string casts.
# Spark cases 23-28 also use ::string; case 03 covers that conversion separately.

# Spark case 23 (extraction only)
# TODO: Decode backtick-quoted field names; this currently returns SQL NULL.
skipif DataFusion
query T
SELECT variant_to_json(special_chars_variant:`field-name`) FROM variant_test_data;
----
"value1"

# Spark case 24 (extraction only)
query T
SELECT variant_to_json(special_chars_variant:['field-name']) FROM variant_test_data;
----
"value1"

# Spark case 25 (extraction only)
query T
SELECT variant_to_json(special_chars_variant:field_name) FROM variant_test_data;
----
"value3"

# Spark case 26 (extraction only)
query T
SELECT variant_to_json(special_chars_variant:['field_name']) FROM variant_test_data;
----
"value3"

# Not supported; will return NULL.
# Spark case 27 (extraction only)
# Spark also returns SQL NULL for this backtick-quoted dotted key.
query B
SELECT (special_chars_variant:`field.name`) IS NULL FROM variant_test_data;
----
true

# Using [] is okay.
# Spark case 28 (extraction only)
query T
SELECT variant_to_json(special_chars_variant:['field.name']) FROM variant_test_data;
----
"value2"

# Array operations on Variant arrays.
# Spark case 29
# Spark schema: struct<(CAST(variant_get(multi_field_variant, $.scores[0]) AS scores AS INT) + CAST(variant_get(multi_field_variant, $.scores[1]) AS scores AS INT)):int>
# TODO: Support SQL casts of extracted variants and arithmetic on the converted values.
skipif DataFusion
query I
select multi_field_variant:scores[0]::int + multi_field_variant:scores[1]::int from variant_test_data;
----
177

# Spark case 30
# Spark schema: struct<count(1):bigint>
# TODO: Support Spark explode and SQL CAST from variant to ARRAY<INT>.
skipif DataFusion
query I
select count(*) from (select explode(cast(multi_field_variant:scores as array<int>)) as score from variant_test_data);
----
3

# ASTERISK syntax.
# Spark case 31
# Spark schema: struct<int_price_variant:variant,double_price_variant:variant,multi_field_variant:variant,array_value_variant:variant,array_variant:variant,nested_variant:variant,special_chars_variant:variant>
query TTTTTTT
SELECT variant_to_json(c1), variant_to_json(c2), variant_to_json(c3), variant_to_json(c4), variant_to_json(c5), variant_to_json(c6), variant_to_json(c7)
FROM (
  select * from variant_test_data
) AS spark_result(c1, c2, c3, c4, c5, c6, c7);
----
{"price":30} {"price":12345.678} {"active":true,"age":30,"city":"New York","name":"John","scores":[85,92,78]} {"item":[{"model":"basic","price":6.12},{"model":"medium","price":9.24}]} [{"id":1,"name":"Alice"},{"id":2,"name":"Bob"},{"id":3,"name":"Charlie"}] {"metadata":{"nested":{"level":2,"value":"deep"},"tags":["important","urgent"],"version":"1.0"}} {"field-name":"value1","field.name":"value2","field_name":"value3"}

# Not supported; will throw an error.
# Spark case 32
# Spark schema: struct<>
# Spark expected error: PARSE_SYNTAX_ERROR (*)
statement error ParserError.*found: \*
select multi_field_variant:* from variant_test_data;

# Type checking: The result of the following would all be 'variant'.
# Spark case 33
# Spark schema: struct<typeof(variant_get(multi_field_variant, $.name) AS name):string>
# TODO: Provide Spark typeof with the logical variant type name.
skipif DataFusion
query T
select typeof(multi_field_variant:name) from variant_test_data;
----
variant

# Spark case 34
# Spark schema: struct<typeof(variant_get(multi_field_variant, $.age) AS age):string>
# TODO: Provide Spark typeof with the logical variant type name.
skipif DataFusion
query T
select typeof(multi_field_variant:age) from variant_test_data;
----
variant

# Spark case 35
# Spark schema: struct<typeof(variant_get(multi_field_variant, $.active) AS active):string>
# TODO: Provide Spark typeof with the logical variant type name.
skipif DataFusion
query T
select typeof(multi_field_variant:active) from variant_test_data;
----
variant

# Spark case 36
# Spark schema: struct<typeof(variant_get(multi_field_variant, $.scores) AS scores):string>
# TODO: Provide Spark typeof with the logical variant type name.
skipif DataFusion
query T
select typeof(multi_field_variant:scores) from variant_test_data;
----
variant

# Variant field access with NULL handling.
# Spark case 37
# Spark schema: struct<(variant_get(multi_field_variant, $.missing_field) AS missing_field IS NULL):boolean>
# Spark isnull(expr) is expressed as the equivalent SQL predicate.
query B
select (multi_field_variant:missing_field) IS NULL from variant_test_data;
----
true

# Spark case 38
# Spark schema: struct<(variant_get(multi_field_variant, $.name) AS name IS NOT NULL):boolean>
# Spark isnotnull(expr) is expressed as the equivalent SQL predicate.
query B
select (multi_field_variant:name) IS NOT NULL from variant_test_data;
----
true

# Spark case 39
# Spark schema: struct<coalesce(variant_get(multi_field_variant, $.missing_field) AS missing_field, default_value):variant>
# TODO: Support common-type coercion between variant and string in coalesce.
skipif DataFusion
query T
SELECT variant_to_json(c1)
FROM (
  select coalesce(multi_field_variant:missing_field, 'default_value') from variant_test_data
) AS spark_result(c1);
----
"default_value"

# Additional path cases verified on Spark 4.2.0, outside the pinned source suite.
statement ok
CREATE VIEW additional_path_data AS
SELECT json_to_variant('{"name":"lower","field name":"space","a]b":"bracket"}') AS v;

# Backticks around an ordinary field name.
# TODO: Decode backtick-quoted field names; this currently returns SQL NULL.
skipif DataFusion
query T
SELECT variant_to_json(v:`name`) FROM additional_path_data;
----
"lower"

# Backticks around a field name containing a space.
# TODO: Decode backtick-quoted field names; this currently returns SQL NULL.
skipif DataFusion
query T
SELECT variant_to_json(v:`field name`) FROM additional_path_data;
----
"space"

# A closing bracket inside a quoted field name is part of the key.
# TODO: Preserve quoted closing brackets; the getter currently reports a path-parser error.
skipif DataFusion
query T
SELECT variant_to_json(v:['a]b']) FROM additional_path_data;
----
"bracket"

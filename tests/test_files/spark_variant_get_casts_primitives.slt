# Commit: 32f7299601108917fb01920a54e084595b7b3bf8
# Source: https://github.com/apache/spark/blob/32f7299601108917fb01920a54e084595b7b3bf8/sql/catalyst/src/test/scala/org/apache/spark/sql/catalyst/expressions/variant/VariantExpressionSuite.scala
# Adaptations to the current API (TODO #71):
# - The root path is '' instead of Spark's '$'; type hints use Arrow names.
# - Successful casts exercise direct, extract-then-cast, and try routes.
# - Failed casts check strict errors and try_variant_get NULL results.
# Null-safe equality avoids engine-specific display formats.
# Expected values independently executed on Spark 4.2.0, ANSI enabled, UTC.
# Every TODO below refers to https://github.com/datafusion-contrib/datafusion-variant/issues/71.

# expr-001: VariantExpressionSuite.scala:294 — variant_get cast
query BBB
WITH input AS (SELECT json_to_variant('"true"') AS v)
SELECT variant_get(v, '', 'Boolean') IS NOT DISTINCT FROM true,
  variant_get(variant_get(v, ''), '', 'Boolean') IS NOT DISTINCT FROM true,
  try_variant_get(v, '', 'Boolean') IS NOT DISTINCT FROM true FROM input;
----
true true true


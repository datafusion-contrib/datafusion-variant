statement ok
CREATE TABLE json_data (id INT, json_str TEXT) AS VALUES
  (1, '{"name": "Alice", "age": 30}'),
  (2, '{"name": "Bob", "age": 25}'),
  (3, '{"items": [1, 2, 3], "count": 3}'),
  (4, '{"items": [{"name": "Sam", "age": 33}, "a", 3], "count": 3}'),
  (5, 'null'),
  (6, '"simple string"'),
  (7, '["looooooooong string", "hehe", "a"]'),
  (8, 'true');


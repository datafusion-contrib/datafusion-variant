# Columns are named after the `:` syntax. The root path and the type-hint form keep the function name.
statement ok
CREATE TABLE events AS SELECT id, parse_json(json_str) AS event FROM json_data;

query TTT
DESCRIBE SELECT event:name, variant_get(event, ''), variant_get(event, 'age', 'INT') FROM events;
----
events.event:name Variant YES
variant_get(events.event,Utf8("")) Variant YES
variant_get(events.event,Utf8("age"),Utf8("INT")) Int32 YES

# Qualifiers keep the same path on both sides of a join distinct, also inside an expression input.
query TTT
DESCRIBE SELECT parse_json(a.json_str):name, parse_json(b.json_str):name FROM json_data a JOIN json_data b ON a.id = b.id;
----
parse_json(a.json_str):name Variant YES
parse_json(b.json_str):name Variant YES

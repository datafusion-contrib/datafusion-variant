# tests the variant_object_insert udf
# this function takes a variant object, a string key, and a variant value,
# and inserts the key-value pair into the object (or updates if key exists)

# Create test data
statement ok
CREATE TABLE test_data (id INT, name TEXT, age INT, active BOOL) AS VALUES
  (1, 'Norm', 50, true),
  (2, 'Marie', 22, false),
  (3, 'Joe', 31, true);

# Test 1: Insert a simple string value into an empty object
query ?
SELECT variant_object_insert(
  parse_json('{}'),
  'name',
  parse_json('"Alice"')
);
----
{"name":"Alice"}

# Test 2: Insert a number into an object with existing fields
query ?
SELECT variant_object_insert(
  variant_object_construct('name', parse_json('"Bob"')),
  'age',
  parse_json('25')
);
----
{"age":25,"name":"Bob"}

# Test 3: Update an existing key
query ?
SELECT variant_object_insert(
  variant_object_construct(
    'name', parse_json('"Charlie"'),
    'age', parse_json('30')
  ),
  'age',
  parse_json('31')
);
----
{"age":31,"name":"Charlie"}

# Test 4: Insert a boolean value
query ?
SELECT variant_object_insert(
  variant_object_construct('name', parse_json('"David"')),
  'active',
  parse_json('true')
);
----
{"active":true,"name":"David"}

# Test 5: Insert a null value
query ?
SELECT variant_object_insert(
  variant_object_construct('name', parse_json('"Eve"')),
  'middle_name',
  parse_json('null')
);
----
{"middle_name":null,"name":"Eve"}

# Test 6: Insert a nested object
query ?
SELECT variant_object_insert(
  variant_object_construct('name', parse_json('"Frank"')),
  'address',
  parse_json('{"city": "NYC", "zip": 10001}')
);
----
{"address":{"city":"NYC","zip":10001},"name":"Frank"}

# Test 7: Insert an array value
query ?
SELECT variant_object_insert(
  variant_object_construct('name', parse_json('"Grace"')),
  'scores',
  parse_json('[95, 87, 92]')
);
----
{"name":"Grace","scores":[95,87,92]}

# Test 8: Insert with numeric key (as string)
query ?
SELECT variant_object_insert(
  parse_json('{"0": "zero"}'),
  '1',
  parse_json('"one"')
);
----
{"0":"zero","1":"one"}

# Test 9: Chain multiple inserts
query ?
SELECT variant_object_insert(
  variant_object_insert(
    variant_object_construct('a', parse_json('1')),
    'b',
    parse_json('2')
  ),
  'c',
  parse_json('3')
);
----
{"a":1,"b":2,"c":3}

# Test 10: Insert a complex nested structure
query ?
SELECT variant_object_insert(
  variant_object_construct('user', parse_json('"Henry"')),
  'metadata',
  parse_json('{"tags": ["admin", "user"], "count": 42}')
);
----
{"metadata":{"count":42,"tags":["admin","user"]},"user":"Henry"}

# Test 11: Insert with special characters in key
query ?
SELECT variant_object_insert(
  parse_json('{}'),
  'user_name',
  parse_json('"test_user"')
);
----
{"user_name":"test_user"}

# Test 12: Insert with special characters in value
query ?
SELECT variant_object_insert(
  parse_json('{}'),
  'message',
  parse_json('"hello\nworld"')
);
----
{"message":"hello\nworld"}

# Test 13: Insert into object with multiple existing fields
query ?
SELECT variant_object_insert(
  variant_object_construct(
    'a', parse_json('1'),
    'b', parse_json('2'),
    'c', parse_json('3')
  ),
  'd',
  parse_json('4')
);
----
{"a":1,"b":2,"c":3,"d":4}

# Test 14: Update with different type
query ?
SELECT variant_object_insert(
  variant_object_construct('value', parse_json('42')),
  'value',
  parse_json('"forty-two"')
);
----
{"value":"forty-two"}

# Test 15: Insert negative number
query ?
SELECT variant_object_insert(
  parse_json('{}'),
  'temperature',
  parse_json('-10')
);
----
{"temperature":-10}

# Test 16: Insert decimal number
query ?
SELECT variant_object_insert(
  parse_json('{}'),
  'price',
  parse_json('19.99')
);
----
{"price":19.99}

# Test 17: Insert into object with null values
query ?
SELECT variant_object_insert(
  variant_object_construct('a', parse_json('null')),
  'b',
  parse_json('"value"')
);
----
{"a":null,"b":"value"}

# Test 18: Insert empty array
query ?
SELECT variant_object_insert(
  parse_json('{}'),
  'items',
  parse_json('[]')
);
----
{"items":[]}

# Test 19: Insert empty object
query ?
SELECT variant_object_insert(
  variant_object_construct('name', parse_json('"test"')),
  'config',
  parse_json('{}')
);
----
{"config":{},"name":"test"}

# Test 20: Multiple updates to same key
query ?
SELECT variant_object_insert(
  variant_object_insert(
    variant_object_construct('x', parse_json('1')),
    'x',
    parse_json('2')
  ),
  'x',
  parse_json('3')
);
----
{"x":3}

# Cleanup
statement ok
DROP TABLE test_data;

# tests the variant_list_insert udf
# this function takes a variant list and a variant value, and inserts the value into the list

# Create test data
statement ok
CREATE TABLE test_data (id INT, name TEXT, age INT, active BOOL) AS VALUES
  (1, 'Norm', 50, true),
  (2, 'Marie', 22, false),
  (3, 'Joe', 31, true);

# Test 1: Insert a string into a simple list
query ?
SELECT variant_list_insert(
  variant_list_construct(parse_json('"Alice"')),
  parse_json('"Bob"')
);
----
["Alice","Bob"]

# Test 2: Insert a number into a list with multiple elements
query ?
SELECT variant_list_insert(
  variant_list_construct(
    parse_json('"Alice"'),
    parse_json('30'),
    parse_json('true')
  ),
  parse_json('42')
);
----
["Alice",30,true,42]

# Test 3: Insert an object into a list
query ?
SELECT variant_list_insert(
  variant_list_construct(
    parse_json('"admin"')
  ),
  parse_json('{"name": "Bob", "age": 25}')
);
----
["admin",{"age":25,"name":"Bob"}]

# Test 4: Insert an array into a list
query ?
SELECT variant_list_insert(
  variant_list_construct(
    parse_json('1'),
    parse_json('2')
  ),
  parse_json('[3, 4, 5]')
);
----
[1,2,[3,4,5]]

# Test 5: Insert null into a list
query ?
SELECT variant_list_insert(
  variant_list_construct(
    parse_json('"Charlie"'),
    parse_json('42')
  ),
  parse_json('null')
);
----
["Charlie",42,null]

# Test 6: Insert a value into a list with nulls
query ?
SELECT variant_list_insert(
  variant_list_construct(
    parse_json('null'),
    parse_json('null')
  ),
  parse_json('"test"')
);
----
[null,null,"test"]

# Test 7: Insert boolean into a list with booleans
query ?
SELECT variant_list_insert(
  variant_list_construct(
    parse_json('true'),
    parse_json('false')
  ),
  parse_json('true')
);
----
[true,false,true]

# Test 8: Insert a number into a numeric list
query ?
SELECT variant_list_insert(
  variant_list_construct(
    parse_json('1'),
    parse_json('2.5'),
    parse_json('3')
  ),
  parse_json('-10')
);
----
[1,2.5,3,-10]

# Test 9: Insert into a list with complex types
query ?
SELECT variant_list_insert(
  variant_list_construct(
    parse_json('{"key": "value"}'),
    parse_json('[1, 2]')
  ),
  parse_json('"new_item"')
);
----
[{"key":"value"},[1,2],"new_item"]

# Test 10: Insert a string with special characters
query ?
SELECT variant_list_insert(
  variant_list_construct(
    parse_json('"hello world"')
  ),
  parse_json('"foo\nbar"')
);
----
["hello world","foo\nbar"]

# Test 11: Insert into an empty list (single element list that we add to)
query ?
SELECT variant_list_insert(
  parse_json('[]'),
  parse_json('"first"')
);
----
["first"]

# Test 12: Chain multiple inserts
query ?
SELECT variant_list_insert(
  variant_list_insert(
    variant_list_construct(parse_json('"a"')),
    parse_json('"b"')
  ),
  parse_json('"c"')
);
----
["a","b","c"]

# Test 13: Insert nested objects
query ?
SELECT variant_list_insert(
  variant_list_construct(
    parse_json('{"outer": {"inner": 1}}')
  ),
  parse_json('{"data": [1, 2, 3]}')
);
----
[{"outer":{"inner":1}},{"data":[1,2,3]}]

# Cleanup
statement ok
DROP TABLE test_data;

# tests the variant_list_construct udf
# this function takes variant values and constructs a variant list

# Create test data
statement ok
CREATE TABLE test_data (id INT, name TEXT, age INT, active BOOL) AS VALUES
  (1, 'Norm', 50, true),
  (2, 'Marie', 22, false),
  (3, 'Joe', 31, true);

# Test 1: Simple list with one element
query ?
SELECT variant_list_construct(parse_json('"Alice"'));
----
["Alice"]

# Test 2: List with multiple elements of different types
query ?
SELECT variant_list_construct(
  parse_json('"Alice"'),
  parse_json('30'),
  parse_json('true')
);
----
["Alice",30,true]

# Test 3: List with nested object
query ?
SELECT variant_list_construct(
  parse_json('{"name": "Bob", "age": 25}'),
  parse_json('"admin"')
);
----
[{"age":25,"name":"Bob"},"admin"]

# Test 4: List with nested array
query ?
SELECT variant_list_construct(
  parse_json('[1, 2, 3]'),
  parse_json('5')
);
----
[[1,2,3],5]

# Test 5: List with null values
query ?
SELECT variant_list_construct(
  parse_json('"Charlie"'),
  parse_json('null'),
  parse_json('42')
);
----
["Charlie",null,42]

# Test 6: List with all nulls
query ?
SELECT variant_list_construct(
  parse_json('null'),
  parse_json('null')
);
----
[null,null]

# Test 7: List with boolean values
query ?
SELECT variant_list_construct(
  parse_json('true'),
  parse_json('false'),
  parse_json('true')
);
----
[true,false,true]

# Test 8: List with numeric values
query ?
SELECT variant_list_construct(
  parse_json('1'),
  parse_json('2.5'),
  parse_json('3'),
  parse_json('-10')
);
----
[1,2.5,3,-10]

# Test 9: List with string values
query ?
SELECT variant_list_construct(
  parse_json('"first"'),
  parse_json('"second"'),
  parse_json('"third"')
);
----
["first","second","third"]

# Test 10: List with mixed complex types
query ?
SELECT variant_list_construct(
  parse_json('{"key": "value"}'),
  parse_json('[1, 2]'),
  parse_json('"string"'),
  parse_json('123'),
  parse_json('null')
);
----
[{"key":"value"},[1,2],"string",123,null]

# Test 11: List with special characters in strings
query ?
SELECT variant_list_construct(
  parse_json('"hello world"'),
  parse_json('"foo\nbar"'),
  parse_json('"test\"quote"')
);
----
["hello world","foo\nbar","test\"quote"]

# Cleanup
statement ok
DROP TABLE test_data;

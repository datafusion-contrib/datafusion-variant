# query ?
# SELECT variant_object_construct(
#     'name', parse_json('"' || name || '"'),
#     'age', parse_json(CAST(age AS TEXT)),
#     'active', parse_json(CAST(active AS TEXT))
# ) FROM test_data ORDER BY id;
# ----
# {"active":true,"age":30,"name":"Alice"}
# {"active":false,"age":25,"name":"Bob"}
# {"active":true,"age":35,"name":"Charlie"}

# Test 7: Object with numeric keys (still must be strings)
query ?
SELECT variant_object_construct(
  '0', parse_json('"first"'),
  '1', parse_json('"second"')
);
----
{"0":"first","1":"second"}

# Cleanup
statement ok
DROP TABLE test_data;

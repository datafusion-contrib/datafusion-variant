# tests the variant_object_construct udf
# this function takes alternating key-value pairs where keys are strings
# values are variants, and constructs a variant object


# Create test data
statement ok
CREATE TABLE test_data (id INT, name TEXT, age INT, active BOOL) AS VALUES
  (1, 'Norm', 50, true),
  (2, 'Marie', 22, false),
  (3, 'Joe', 31, true);

# Test 1: Simple object with one key-value pair
query ?
SELECT variant_object_construct('name', parse_json('"Alice"'));
----
{"name":"Alice"}

# Test 2: Object with multiple fields of different types
query ?
SELECT variant_object_construct(
  'name', parse_json('"Alice"'),
  'age', parse_json('30'),
  'active', parse_json('true')
);
----
{"active":true,"age":30,"name":"Alice"}

# Test 3: Object with nested values
query ?
SELECT variant_object_construct(
  'user', parse_json('{"name": "Bob", "age": 25}'),
  'role', parse_json('"admin"')
);
----
{"role":"admin","user":{"age":25,"name":"Bob"}}

# Test 4: Object with array value
query ?
SELECT variant_object_construct(
  'items', parse_json('[1, 2, 3]'),
  'count', parse_json('3')
);
----
{"count":3,"items":[1,2,3]}

# Test 5: Object with null value
query ?
SELECT variant_object_construct(
  'name', parse_json('"Charlie"'),
  'middle_name', parse_json('null')
);
----
{"middle_name":null,"name":"Charlie"}

# todo: uncomment when we support array cases

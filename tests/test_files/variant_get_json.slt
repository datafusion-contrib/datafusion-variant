CREATE TABLE json_data (id INT, json_str TEXT) AS VALUES
  (1, '{"name": "Alice", "age": 30}'),
  (2, '{"name": "Bob", "age": 25}'),
  (3, '{"items": [1, 2, 3], "count": 3}'),
  (4, 'null'),
  (5, '"simple string"'),
  (6, '123'),
  (7, 'true'),
  (8, '{"pi": 3.14, "active": true}');

# string values are returned with json quotes (unlike variant_get with a VARCHAR target)
query T
select variant_get_json(parse_json(json_str), 'name') from json_data;
----
"Alice"
"Bob"
NULL
NULL
NULL
NULL
NULL
NULL

# integer values are json-serialized
query T
select variant_get_json(parse_json(json_str), 'age') from json_data;
----
30
25
NULL
NULL
NULL
NULL
NULL
NULL

# float values are json-serialized
query T
select variant_get_json(parse_json(json_str), 'pi') from json_data;
----
NULL
NULL
NULL
NULL
NULL
NULL
NULL
3.14

# boolean values are json-serialized
query T
select variant_get_json(parse_json(json_str), 'active') from json_data;
----
NULL
NULL
NULL
NULL
NULL
NULL
NULL
true

# array values are json-serialized
query T
select variant_get_json(parse_json(json_str), 'items') from json_data;
----
NULL
NULL
[1,2,3]
NULL
NULL
NULL
NULL
NULL

# missing paths return null
query T
select variant_get_json(parse_json(json_str), 'nonexistent') from json_data;
----
NULL
NULL
NULL
NULL
NULL
NULL
NULL
NULL

# scalar variant with nested object
query T
select variant_get_json(parse_json('{"obj": {"a": 1}}'), 'obj');
----
{"a":1}

# scalar variant with null value
query T
select variant_get_json(parse_json('{"key": null}'), 'key');
----
null

# nested path
query T
select variant_get_json(parse_json('{"obj": {"a": "hello"}}'), 'obj.a');
----
"hello"

# nested numeric path
query T
select variant_get_json(parse_json('{"obj": {"a": 42}}'), 'obj.a');
----
42

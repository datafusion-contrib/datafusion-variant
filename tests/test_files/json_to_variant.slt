# Exercise each accepted physical string type on a materialized nullable column.
statement ok
CREATE TABLE json_string_inputs(id INT, json VARCHAR, required_json VARCHAR NOT NULL);

statement ok
INSERT INTO json_string_inputs VALUES (1, '123', 'null'), (2, NULL, 'null'), (3, 'null', 'null');

statement ok
CREATE VIEW parsed_json AS SELECT id,
  json_to_variant(arrow_cast(json, 'Utf8')) AS utf8,
  json_to_variant(arrow_cast(json, 'LargeUtf8')) AS large_utf8,
  json_to_variant(arrow_cast(json, 'Utf8View')) AS utf8_view,
  json_to_variant(required_json) AS required
FROM json_string_inputs;

query ITTT
SELECT id, variant_to_json(utf8), variant_to_json(large_utf8), variant_to_json(utf8_view)
FROM parsed_json ORDER BY id;
----
1 123 123 123
2 NULL NULL NULL
3 null null null

# Literal arguments exercise constant evaluation; the ordinary Utf8 SQL/Variant
# null distinction is already covered in variant_nulls.slt.
query TBB
SELECT variant_to_json(json_to_variant(arrow_cast('123', 'LargeUtf8'))),
  json_to_variant(arrow_cast(NULL, 'Utf8View')) IS NULL,
  is_variant_null(json_to_variant(arrow_cast('null', 'LargeUtf8')));
----
123 true true

# Strict parsing cannot introduce SQL nulls. JSON 'null' remains a present value.
# Spark reference: SPARK-48150 (VariantExpressionSuite:871-878).
statement ok
SET datafusion.catalog.information_schema = true;

query TT
SELECT column_name, is_nullable FROM information_schema.columns
WHERE table_name = 'parsed_json' AND column_name <> 'id' ORDER BY column_name;
----
large_utf8 YES
required NO
utf8 YES
utf8_view YES

# Preserve the Variant extension annotation used by downstream UDFs.
query T
SELECT arrow_metadata(utf8, 'ARROW:extension:name') FROM parsed_json WHERE id = 1;
----
arrow.parquet.variant

# A malformed row must fail the whole column evaluation, for each string type.
statement ok
INSERT INTO json_string_inputs VALUES (4, '{', 'null');

statement error JSON format error
SELECT json_to_variant(arrow_cast(json, 'Utf8')) FROM json_string_inputs;

statement error JSON format error
SELECT json_to_variant(arrow_cast(json, 'LargeUtf8')) FROM json_string_inputs;

statement error JSON format error
SELECT json_to_variant(arrow_cast(json, 'Utf8View')) FROM json_string_inputs;

# Utf8 literal errors are covered by the Spark-derived cases below.
statement error JSON format error
SELECT json_to_variant(arrow_cast('{', 'LargeUtf8'));

statement error JSON format error
SELECT json_to_variant(arrow_cast('{', 'Utf8View'));

# Adapted from Apache Spark 4.2.0, licensed under Apache-2.0.
# Pinned commit: 32f7299601108917fb01920a54e084595b7b3bf8
# Eval source: https://github.com/apache/spark/blob/32f7299601108917fb01920a54e084595b7b3bf8/sql/catalyst/src/test/scala/org/apache/spark/sql/catalyst/expressions/variant/VariantExpressionEvalUtilsSuite.scala
# SQL source: https://github.com/apache/spark/blob/32f7299601108917fb01920a54e084595b7b3bf8/sql/core/src/test/scala/org/apache/spark/sql/VariantSuite.scala
# Parser: https://github.com/apache/spark/blob/32f7299601108917fb01920a54e084595b7b3bf8/common/variant/src/main/java/org/apache/spark/types/variant/VariantBuilder.java
# Adaptations: parse_json -> json_to_variant; to_json -> variant_to_json.
# Expected JSON/error outcomes were checked with Spark 4.2.0's VariantBuilder,
# duplicate keys disallowed and Unicode validation enabled; JSON output uses UTC.
# Compare logical JSON, not object dictionary order or byte-for-byte encoding.
# All TODOs refer to https://github.com/datafusion-contrib/datafusion-variant/issues/71.
# This is coverage toward parity, not a claim that the remaining gaps are fixed.
# Skipped records preserve outstanding precision and duplicate-key expectations.

# Round-trip matrix, including EvalUtilsSuite scalar/container and Unicode cases. Integer encoding widths and
# short-string thresholds belong to Arrow's parser tests; here values matter.
# Materialize input so this exercises the column path.
statement ok
CREATE TABLE spark_json_inputs(id INT, json VARCHAR, expected VARCHAR);

statement ok
INSERT INTO spark_json_inputs VALUES
  (1, 'false', 'false'),
  (2, '9223372036854775807', '9223372036854775807'),
  (3, '-9223372036854775808', '-9223372036854775808'),
  (4, '""', '""'),
  (5, '{}', '{}'),
  (6, '[]', '[]'),
  (7, '[null, true, {"false" : 0}]', '[null,true,{"false":0}]'),
  (8, '"\uD83D\uDE05"', '"😅"'),
  (9, '{"\uD83D\uDE05":1}', '{"😅":1}'),
  (10, '["\uD835\uDC00"]', '["𝐀"]'),
  (11, '{"b": [{"c": "str2"}]}', '{"b":[{"c":"str2"}]}'),
  -- Basic round-trip cases from the original local suite.
  (12, 'true', 'true'),
  (13, '"simple string"', '"simple string"'),
  (14, '{"name": "Alice", "age": 30}', '{"age":30,"name":"Alice"}'),
  (15, '{"items": [1, 2, 3], "count": 3}', '{"count":3,"items":[1,2,3]}');

query IB
SELECT id, variant_to_json(json_to_variant(json)) IS NOT DISTINCT FROM expected
FROM spark_json_inputs ORDER BY id;
----
1 true
2 true
3 true
4 true
5 true
6 true
7 true
8 true
9 true
10 true
11 true
12 true
13 true
14 true
15 true

